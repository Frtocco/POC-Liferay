# Plantilla de configuracion local para tools/catalog.
# 1. Copiala como .env.local en esta misma carpeta (tools/catalog/.env.local).
# 2. Completa tus valores. .env.local NO se commitea.
# Los IDs cambian en cada instalacion de Liferay: cada uno pone los de su entorno.

LIFERAY_BASE_URL=http://localhost:8080
LIFERAY_USER=test@liferay.com
# Opcional: si lo dejas vacio, el script pide la password al correr.
LIFERAY_PASSWORD=
LIFERAY_SITE_ID=
LIFERAY_STRUCTURE_ID=

# API key de TMDB (themoviedb.org > Settings > API). Sirve la "API Key" o el "API Read Access Token".
TMDB_API_KEY=
